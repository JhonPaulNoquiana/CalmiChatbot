# Flask Backend Configuration
FLASK_ENV=development
FLASK_APP=run.py

# PostgreSQL Database Configuration
# Local PostgreSQL (Windows/Mac/Linux with PostgreSQL installed)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/calmi_dev

# Cloud PostgreSQL Options:
# AWS RDS: postgresql://username:password@db-instance.region.rds.amazonaws.com:5432/calmi
# Heroku: postgresql://username:password@ec2-23-21-91-101.compute-1.amazonaws.com:5432/d123abc
# Railway: postgresql://username:password@db.railway.app:5432/calmi
# Render: postgresql://username:password@dpg-xxxxx.render.com:5432/calmi

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here_change_in_production
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# Server Configuration
PORT=5000
DEBUG=True

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
